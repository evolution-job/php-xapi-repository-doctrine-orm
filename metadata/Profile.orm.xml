<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
        http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="XApi\Repository\Doctrine\Mapping\Profile" repository-class="XApi\Repository\ORM\ProfileRepository"
            table="xapi_profile">
        <id name="resource" type="string">
            <generator strategy="NONE" />
        </id>
        <id name="profileId" type="string" column="profile_id">
            <generator strategy="NONE" />
        </id>
        <field name="content" type="text" />
        <field name="contentType" type="string" column="content_type" />
        <field name="updated" type="datetime_immutable" />
    </entity>
</doctrine-mapping>
